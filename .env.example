# === Sao chép file này thành ".env" (cùng thư mục với docker-compose.yml) ===
# === rồi điền giá trị thật vào. KHÔNG commit file ".env" lên Git. ===
# (.gitignore của dự án đã có sẵn dòng ".env" nên sẽ tự động được bỏ qua)

# Mật khẩu tài khoản "sa" của SQL Server chạy trong Docker.
# Yêu cầu tối thiểu: >= 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
SA_PASSWORD=YourStrong!Passw0rd

# Khoá ký JWT - có thể giữ giá trị đang có trong appsettings.json hoặc đổi khoá khác dài hơn.
JWT_KEY=KhoaBiMatCuaSonChoDuAnQuanLyNoiThat123456789!@#

# Thông tin Cloudinary (lấy tại https://console.cloudinary.com -> Dashboard).
# Đây là nơi lưu ảnh sản phẩm thật sự, container KHÔNG lưu ảnh nên bắt buộc phải điền đúng 3 giá trị này.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Tài khoản Gmail dùng để gửi email (quên mật khẩu, v.v...) - dùng App Password của Gmail, không phải mật khẩu Gmail thường.
SMTP_SENDER_EMAIL=nhinvn8@gmail.com
SMTP_SENDER_APP_PASSWORD=
