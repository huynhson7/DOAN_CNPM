# === Sao chép file này thành ".env" (cùng cấp với docker-compose.yml) rồi chỉnh giá trị ===
# File ".env" đã nằm trong .gitignore -> KHÔNG bị commit lên GitHub, mỗi máy tự có mật khẩu riêng.

# Mật khẩu tài khoản 'sa' của SQL Server chạy trong Docker.
# Yêu cầu của SQL Server: tối thiểu 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
SA_PASSWORD=YourStrong@Passw0rd

# false = tạo database mới HTQLCHBNT + dữ liệu mẫu từ Backend/Database/SqlCNPM.sql (khuyên dùng, nhanh, ai chạy cũng có sẵn dữ liệu mẫu)
# true  = phục hồi (RESTORE) database từ file Backend/Database/BAK (dữ liệu thật, file nặng hơn)
USE_BACKUP=true